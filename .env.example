# Crisna Immobiliare — variabili pubbliche (prefisso VITE_)
# Copia questo file in .env e adatta i valori prima del deploy.

# URL pubblico del sito (senza slash finale)
VITE_SITE_URL=https://www.crisnaimmobiliare.it

# Base path (lascia / se il sito è sulla root del dominio)
VITE_BASE=/

# Endpoint form (Formspree, Getform, Web3Forms, webhook custom)
# Esempio Formspree: https://formspree.io/f/xxxxxxxx
# Se vuoto, i form restano in modalità demo (toast locale)
VITE_FORM_ENDPOINT=

# Opzionale: chiave Web3Forms
# VITE_WEB3FORMS_KEY=
